<?xml version="1.0" encoding="utf-8"?>
<!-- Premium small-card face: layered dark edge, gold lip, suit-color gloss, ivory rank panel. Code supplies rank and suit icon. Keep this resource name stable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#39343D" android:centerColor="#17151A" android:endColor="#08090D" /><corners android:radius="8dp" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="#D7AD52" /><corners android:radius="7dp" /></shape></item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp"><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#EF4C83" android:centerColor="#C31D57" android:endColor="#54102B" /><corners android:radius="6dp" /></shape></item>
    <item android:left="8dp" android:top="17dp" android:right="8dp" android:bottom="17dp"><shape android:shape="oval"><gradient android:angle="0" android:startColor="#FFF9E9" android:centerColor="#F5E8C8" android:endColor="#E4D1A5" /><stroke android:width="1dp" android:color="#79173A" /></shape></item>
    <item android:left="5dp" android:top="4dp" android:right="5dp" android:bottom="4dp"><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#55FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" /><corners android:radius="6dp" /></shape></item>
</layer-list>
